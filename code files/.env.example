# Required for real Gemini generation
GEMINI_API_KEY=your_gemini_api_key_here

# Current model defaults can be changed if your Google AI Studio account exposes
# different model IDs.
WORKOUT_MODEL=gemini-3.1-pro
FAST_MODEL=gemini-3.8-flash

# Local SQLite database
DATABASE_URL=sqlite:///./fitbuddy.db

# Change this before using the admin delete function
ADMIN_TOKEN=change-me

DEBUG=true
